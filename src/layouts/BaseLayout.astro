---
import "../styles/global.css";
import { publicSiteOriginFromEnv } from "../lib/resolve-public-site-origin";
import { shouldNoindex } from "../lib/site-indexing";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  lang?: string;
}

const { title, description, currentPath = "/", lang = "en" } = Astro.props;
const canonical = Astro.site ? new URL(currentPath, Astro.site).toString() : undefined;
const ogLocale = lang === "ja" ? "ja_JP" : "en_US";
const noindex = shouldNoindex(publicSiteOriginFromEnv());
const ogImage = Astro.site ? new URL("/og-image.jpg", Astro.site).toString() : undefined;
const ogImageAlt = "Junya Nakazato — Web Engineer / Tech Lead。沖縄の海の写真を背景にした紹介画像";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="jey3dayo.net" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
