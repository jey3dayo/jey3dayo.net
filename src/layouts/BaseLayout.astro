---
import "../styles/global.css";
import { ultraRssReaderRoutes } from "../data/ultra-rss-reader";
import { publicSiteOriginFromEnv } from "../lib/resolve-public-site-origin";
import { shouldNoindex } from "../lib/site-indexing";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  lang?: string;
  variant?: "legacy" | "bare";
}

const { title, description, currentPath = "/", lang = "en", variant = "legacy" } = Astro.props;
const canonical = Astro.site ? new URL(currentPath, Astro.site).toString() : undefined;
const ogLocale = lang === "ja" ? "ja_JP" : "en_US";
const noindex = shouldNoindex(publicSiteOriginFromEnv());
const ogImage = Astro.site ? new URL("/og-image.jpg", Astro.site).toString() : undefined;
const ogImageAlt = "Junya Nakazato — Web Engineer / Tech Lead。沖縄の海の写真を背景にした紹介画像";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="jey3dayo.net" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <slot name="head" />
  </head>
  <body>
    {variant === "bare" ? (
      <slot />
    ) : (
    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">
          <span class="brand-mark">J</span>
          <span>apps.jey3dayo.net</span>
        </a>
        <nav class="topbar-nav" aria-label="Primary">
          <a class="pill" href="/">Home</a>
          <a class="pill" href={ultraRssReaderRoutes.landing} data-active={currentPath === ultraRssReaderRoutes.landing}>
            Ultra RSS Reader
          </a>
          <a class="pill" href={ultraRssReaderRoutes.support} data-active={currentPath === ultraRssReaderRoutes.support}>
            Support
          </a>
          <a class="pill" href={ultraRssReaderRoutes.download} data-active={currentPath === ultraRssReaderRoutes.download}>
            Download
          </a>
          <a class="pill" href={ultraRssReaderRoutes.privacy} data-active={currentPath === ultraRssReaderRoutes.privacy}>
            Privacy
          </a>
        </nav>
      </header>
      <main class="page">
        <slot />
      </main>
      <footer class="footer">
        <p>support、download、privacy などの公開アプリページをまとめるサイトです。</p>
        <p class="footer-translation">Public app pages for support, downloads, and privacy information.</p>
      </footer>
    </div>
    )}
  </body>
</html>
