---
import About from "../components/portfolio/About.astro";
import ContactFooter from "../components/portfolio/ContactFooter.astro";
import Experience from "../components/portfolio/Experience.astro";
import Hero from "../components/portfolio/Hero.astro";
import Works from "../components/portfolio/Works.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Junya Nakazato — Web Engineer / Tech Lead"
  description="沖縄・那覇在住。業務システムの設計・実装と、趣味で個人開発もしています。"
  currentPath="/"
  lang="ja"
  variant="bare"
>
  <Hero />
  <main class="mx-auto flex w-full max-w-5xl flex-col gap-16 px-4 py-14 sm:px-6">
    <Works />
    <About />
    <Experience />
  </main>
  <ContactFooter />
</BaseLayout>
