---
import { snsLinks } from "../../data/sns";
import { buttonVariants } from "../ui/button";
import SnsIcon from "./SnsIcon.astro";

const urrLinks = [
  { label: "Ultra RSS Reader", href: "https://ultra-rss.jey3dayo.net" },
  { label: "Ultra RSS Reader サポート", href: "https://ultra-rss.jey3dayo.net/ja/support/" },
];
const linkClass = buttonVariants({ variant: "outline", size: "touch" });
---

<footer class="border-t">
  <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight">Contact</h2>
    <p class="mt-4 text-base leading-relaxed">連絡は各SNSから。Ultra RSS Reader の不具合は GitHub Issue、サポートは専用ページへ。</p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {snsLinks.map(({ id, label, href }) => (
        <li>
          <a class={linkClass} href={href} target="_blank" rel="noopener noreferrer">
            <SnsIcon id={id} class="size-4" />
            {label}
          </a>
        </li>
      ))}
      {urrLinks.map(({ label, href }) => (
        <li>
          <a class={linkClass} href={href} target="_blank" rel="noopener noreferrer">{label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
