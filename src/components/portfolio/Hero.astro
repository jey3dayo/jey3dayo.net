---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/hero/okinawa-sea.jpg";
import { snsLinks } from "../../data/sns";
import { cn } from "../../lib/utils";
import { buttonVariants } from "../ui/button";
import SnsIcon from "./SnsIcon.astro";

const ctaClass = cn(buttonVariants({ variant: "hero", size: "touch" }));
const snsClass = cn(buttonVariants({ variant: "heroOutline", size: "icon" }), "rounded-full");
---

<header class="relative isolate overflow-hidden bg-hero text-hero-foreground">
  <Image
    src={heroPhoto}
    alt=""
    widths={[640, 1177]}
    sizes="100vw"
    format="webp"
    quality={85}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-bottom"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-linear-to-b from-hero/80 via-hero/72 to-hero/80 lg:from-hero/30 lg:via-hero/28 lg:to-hero/38 dark:from-hero/80 dark:via-hero/70 dark:to-hero/75 dark:lg:from-hero/45 dark:lg:via-hero/38 dark:lg:to-hero/48"
  >
  </div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 hidden bg-linear-to-r from-hero/45 to-hero/0 to-80% lg:block"></div>
  <div class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="inline-flex rounded-full bg-hero/70 px-3 py-1 text-sm font-medium">Naha, Okinawa — Japan</p>
    <h1 class="mt-5 text-4xl font-bold tracking-tight sm:text-6xl">Junya Nakazato</h1>
    <p class="mt-2 text-xl font-medium sm:text-2xl">Web Engineer / Tech Lead</p>
    <p class="mt-5 max-w-xl text-base leading-relaxed">沖縄・那覇在住。業務システムの設計・実装と、趣味で個人開発もしています。</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a class={ctaClass} href="#works">Works を見る</a>
      <ul class="flex flex-wrap gap-2">
        {snsLinks.map(({ id, label, href }) => (
          <li>
            <a class={snsClass} href={href} aria-label={label} target="_blank" rel="noopener noreferrer">
              <SnsIcon id={id} class="size-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>
