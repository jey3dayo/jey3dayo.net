---
import { snsLinks } from "../../data/sns";
import { cn } from "../../lib/utils";
import { buttonVariants } from "../ui/button";
import SnsIcon from "./SnsIcon.astro";

const ctaClass = buttonVariants({ variant: "hero", size: "touch" });
const snsClass = cn(buttonVariants({ variant: "heroOutline", size: "icon" }), "rounded-full");
---

<header class="bg-hero text-hero-foreground">
  <div class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="inline-flex rounded-full bg-hero-foreground/15 px-3 py-1 text-sm font-medium">Naha, Okinawa — Japan</p>
    <h1 class="mt-5 text-4xl font-bold tracking-tight sm:text-6xl">Junya Nakazato</h1>
    <p class="mt-2 text-xl font-medium sm:text-2xl">Web Engineer / Tech Lead</p>
    <p class="mt-5 max-w-xl text-base leading-relaxed">沖縄・那覇在住。業務システムの設計・実装と、趣味で個人開発もしています。</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a class={ctaClass} href="#works">Works を見る</a>
      <ul class="flex flex-wrap gap-2">
        {snsLinks.map(({ id, label, href }) => (
          <li>
            <a class={snsClass} href={href} aria-label={label} target="_blank" rel="noopener noreferrer">
              <SnsIcon id={id} class="size-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>
