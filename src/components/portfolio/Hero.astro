---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/hero/okinawa-sea.jpg";
import { snsLinks } from "../../data/sns";
import { cn } from "../../lib/utils";
import { buttonVariants } from "../ui/button";
import SnsIcon from "./SnsIcon.astro";

const ctaClass = cn(buttonVariants({ variant: "hero", size: "touch" }));
const snsClass = cn(buttonVariants({ variant: "heroOutline", size: "icon" }), "rounded-full");
const iconShadow =
  "[filter:drop-shadow(0_0_2px_rgb(0_0_0/0.9))_drop-shadow(0_0_8px_rgb(0_0_0/0.6))]";
const textShadow = [
  "[paint-order:stroke_fill] [-webkit-text-stroke:3px_rgb(0_0_0/0.85)] [text-shadow:0_0_6px_rgb(0_0_0/0.8),0_0_16px_rgb(0_0_0/0.6)]",
  "lg:[-webkit-text-stroke:0] lg:[text-shadow:0_0_2px_rgb(0_0_0/0.9),0_1px_3px_rgb(0_0_0/0.8),0_0_12px_rgb(0_0_0/0.6)]",
].join(" ");
---

<header class="relative isolate overflow-hidden bg-hero text-hero-foreground">
  <Image
    src={heroPhoto}
    alt=""
    widths={[640, 1177]}
    sizes="100vw"
    format="webp"
    quality={85}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-bottom"
  />
  <div class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="hero-enter [--hero-i:0] inline-flex rounded-full bg-hero/70 px-3 py-1 text-sm font-medium">Naha, Okinawa — Japan</p>
    <h1 class={cn("hero-enter [--hero-i:0] mt-5 text-4xl font-bold tracking-tight sm:text-6xl", textShadow)}>Junya Nakazato</h1>
    <p class={cn("hero-enter [--hero-i:1] mt-2 text-xl font-medium sm:text-2xl", textShadow)}>Web Engineer / Tech Lead</p>
    <p class={cn("hero-enter [--hero-i:2] mt-5 max-w-xl text-base leading-relaxed", textShadow)}>沖縄・那覇在住。業務システムの設計・実装と、趣味で個人開発もしています。</p>
    <div class="hero-enter [--hero-i:3] mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a class={ctaClass} href="#works">Works を見る</a>
      <ul class="flex flex-wrap gap-2">
        {snsLinks.map(({ id, label, href }) => (
          <li>
            <a class={snsClass} href={href} aria-label={label} target="_blank" rel="noopener noreferrer">
              <SnsIcon id={id} class={iconShadow + " size-5"} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>
