---
import appIcon from "../../assets/urr/app-icon.png";
import screenshotDark from "../../assets/urr/screenshot-dark.webp";
import screenshotLight from "../../assets/urr/screenshot-light.webp";
import { loadWorks } from "../../lib/works";
import { buttonVariants } from "../ui/button";

const linkLabels = { site: "サイト", github: "GitHub" } as const;
const featuredAlt = "Ultra RSS Reader の画面。3 ペイン構成のデスクトップ RSS リーダー";

const linkClass = buttonVariants({ variant: "outline", size: "touch" });
const works = await loadWorks();
---

<section id="works" aria-labelledby="works-heading" class="scroll-mt-8">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 id="works-heading" class="text-2xl font-bold tracking-tight">Works</h2>
    <p class="text-sm text-muted-foreground">個人開発</p>
  </div>
  <ul class="mt-6 grid gap-4 md:grid-cols-3">
    {works.map((work) => (
      <li class={work.data.featured ? "md:col-span-3" : undefined}>
        <article class="flex h-full flex-col gap-4 rounded-xl border bg-card p-5 text-card-foreground">
          <div class={work.data.featured ? "grid gap-6 md:grid-cols-2 md:items-center" : "contents"}>
            <div class="flex flex-col gap-3">
              <h3 class="flex items-center gap-2 text-lg font-bold">
                {work.data.featured && (
                  <img src={appIcon.src} width={26} height={26} alt="" class="size-[26px] rounded-md" />
                )}
                {work.data.title}
              </h3>
              <p class="text-muted-foreground">{work.data.description}</p>
              <ul class="mt-auto flex flex-wrap gap-2 pt-1">
                {work.data.links.map((link) => (
                  <li>
                    <a
                      class={linkClass}
                      href={link.href}
                      rel="noopener noreferrer"
                    >
                      {linkLabels[link.kind]}<span class="sr-only">（{work.data.title}）</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            {work.data.featured && (
              <picture>
                <source media="(prefers-color-scheme: dark)" srcset={screenshotDark.src} />
                <img
                  src={screenshotLight.src}
                  width={screenshotLight.width}
                  height={screenshotLight.height}
                  alt={featuredAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full rounded-lg border"
                />
              </picture>
            )}
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
