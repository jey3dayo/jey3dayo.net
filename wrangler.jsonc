{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apps-site",
  "compatibility_date": "2026-04-13",
  "routes": [
    {
      "pattern": "jey3dayo.net",
      "custom_domain": true
    },
    {
      "pattern": "www.jey3dayo.net",
      "custom_domain": true
    },
    {
      "pattern": "apps.jey3dayo.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
